  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @felege-yordanos/db db:generate",
    "db:migrate": "pnpm --filter @felege-yordanos/db db:migrate",
    "db:seed": "pnpm --filter @felege-yordanos/db db:seed",
    "db:studio": "pnpm --filter @felege-yordanos/db db:studio",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "dev": "nx serve web",
    "build": "nx build web",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build"
