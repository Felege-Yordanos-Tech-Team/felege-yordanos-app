# Copy this file to .env.local at the repo root and fill in the values.
# Never commit .env.local.

# ─── Database (self-hosted Postgres) ─────────────────────────
# Matches docker-compose.yml. Change the port if 5432 is taken
# (and set POSTGRES_PORT to the same number).
DATABASE_URL=postgres://felege:felege@localhost:5432/felege

# ─── Auth (Better Auth) ──────────────────────────────────────
# Any random string of 32+ characters. The value below is for LOCAL
# DEVELOPMENT ONLY. Staging and production get their own secret:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-only-secret-change-me-0123456789
# The URL the app runs on.
BETTER_AUTH_URL=http://localhost:3000

# ─── File uploads ────────────────────────────────────────────
# Where donation receipts are stored. Default: apps/web/.data/uploads
# UPLOAD_DIR=

# ─── Email ───────────────────────────────────────────────────
# EMAIL_TRANSPORT: console (default in development: emails such as password
# reset links are printed in the terminal running the app) or smtp.
# Staging and production send through Brevo (config/deploy.*.yml).
# EMAIL_TRANSPORT=console
#
# Test real emails locally with Mailpit (no login, no TLS):
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
# then uncomment the lines below and open http://localhost:8025.
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# EMAIL_FROM=Felege Yordanos <no-reply@felegeyordanos.org>
#
# A real SMTP server also needs SMTP_USER and SMTP_PASSWORD (Brevo: SMTP
# login and SMTP key; never put them in this file).

# ─── Google sign-in (optional) ───────────────────────────────
# OAuth client "felege-web" in Google Cloud project felege-yordanos-511106
# (ask the tech team lead). Without both values the "Continue with Google"
# button is hidden and email sign-in works as usual. Local redirect URIs:
# http://localhost:3000/api/auth/callback/google and :3200. Never commit them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
