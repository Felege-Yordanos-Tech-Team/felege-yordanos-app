# Production secrets for Kamal. This file holds NO secret values: each line
# reads an environment variable set by the "Deploy to production" job from the
# GitHub "production" environment. Never write a real value here.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$PRODUCTION_POSTGRES_PASSWORD
DATABASE_URL=postgres://felege:${PRODUCTION_POSTGRES_PASSWORD}@felege-db-production:5432/felege
BETTER_AUTH_SECRET=$PRODUCTION_BETTER_AUTH_SECRET
CLOUDFLARE_ORIGIN_CERT=$(cat "$CLOUDFLARE_ORIGIN_CERT_FILE")
CLOUDFLARE_ORIGIN_KEY=$(cat "$CLOUDFLARE_ORIGIN_KEY_FILE")
