# Staging secrets for Kamal. This file holds NO secret values: each line reads
# an environment variable set by the "Deploy to staging" job from the GitHub
# "staging" environment. Never write a real value here.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$STAGING_POSTGRES_PASSWORD
DATABASE_URL=postgres://felege:${STAGING_POSTGRES_PASSWORD}@felege-db-staging:5432/felege
BETTER_AUTH_SECRET=$STAGING_BETTER_AUTH_SECRET
CLOUDFLARE_ORIGIN_CERT=$(cat "$CLOUDFLARE_ORIGIN_CERT_FILE")
CLOUDFLARE_ORIGIN_KEY=$(cat "$CLOUDFLARE_ORIGIN_KEY_FILE")
